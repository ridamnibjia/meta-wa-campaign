# Docker does not read .gitignore. Without this file `COPY . .` bakes the live
# Meta token, the customer database and any contact CSV into image layers.
.env*
*.db
*.db-wal
*.db-shm
*.db-journal
*.migrated
*.log
*.tmp
*.csv
